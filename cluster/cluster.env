# cluster/cluster.env — single source of truth for cluster paths & expectations.
# Safe to `source` (only exports; no side effects). Used by preflight.sh and
# submit/pull wrappers, and as the human/agent reference for "where things live".
#
# There is ONE repo on the cluster. Do NOT create separate clones/worktrees for
# parallel work — branch + tag instead (see cluster/SKILL notes).

export CLUSTER_SSH_ALIAS="bwunicluster"                 # ssh alias (see ~/.ssh/config)
export CLUSTER_REPO="$HOME/MasterThesisCode"            # THE repo on the cluster
export CLUSTER_WORKSPACE_NAME="emri"                    # ws_allocate / ws_find name
export EMRI_EXPECTED_CATALOG_COLS=8                     # reduced_galaxy_catalogue.csv schema
                                                        #   (8 = redshift-flag retained, commit 479afdd+)
export EMRI_WORKSPACE_WARN_DAYS=14                      # warn if the workspace expires within N days
export EMRI_COMMISSION_TAG="commission-base"            # frozen-code tag for the 2026-07 verification

# Canonical catalog path (gitignored; ~1.6 GB; staged by rsync from the dev box).
export EMRI_CATALOG_CSV="$CLUSTER_REPO/master_thesis_code/galaxy_catalogue/reduced_galaxy_catalogue.csv"

# GOTCHA: the .venv python is linked against the module-provided libpython3.13.so.
# You MUST `source cluster/modules.sh` before running .venv/bin/python or `uv run`.
